{
  "expo": {
    "name": "Danceflow",
    "slug": "danceflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "danceflow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "ru.danceflow.app",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Danceflow использует фото, чтобы собрать черновик танца.",
          "cameraPermission": "Danceflow использует камеру, чтобы сделать фото для танца.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Danceflow использует медиатеку, чтобы управлять сохранёнными танцами.",
          "savePhotosPermission": "Danceflow сохраняет готовые танцы в медиатеку.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#fbf9fd"
    }
  }
}
